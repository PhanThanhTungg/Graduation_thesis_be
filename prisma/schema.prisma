model Note {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  lessonId  String   @map("lesson_id")
  content   String   @db.Text
  timestamp Int      // Timestamp in seconds on the video
  
  user      User     @relation("UserNotes", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  lesson    Lesson   @relation("LessonNotes", fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")

  @@map("note")
}

model WishList {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  courseId  String   @map("course_id")
  
  user      User     @relation("UserWishList", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  course    Course   @relation("CourseWishLists", fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  @@unique([userId, courseId])
  @@map("wish_list")
}