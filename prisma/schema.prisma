generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  teacher
  student
}

enum AdminObject {
  dashboard
  course
  category
  transaction
  payment
  user
  permission
  admin
  setting
}

enum AdminAction {
  view
  edit
  delete
  create
}

enum Status {
  active
  warning
  inactive
}

enum LessonProgress {
  not_started
  in_progress
  completed
}

enum DiscountType {
  percentage
  fixed_amount
}

enum TypeQuestion {
  single_choice
  multiple_choice
  fill_in_the_blank
  short_answer
  true_false
}

enum Difficulty {
  very_easy
  easy
  medium
  hard
  very_hard
}

enum LessonReviewStatus {
  new
  learning
  reviewing
  lapsed
  suspending
}

enum AiModel {
  gemini
  groq
}

enum SprBot {
  telegram
  discord
  chrome_extension
}

model Admin {
  id           String    @id @default(uuid())
  fullName     String    @map("full_name") @db.VarChar(100)
  email        String    @unique @db.VarChar(100)
  passwordHash String    @map("password_hash")
  adminRoleId  String    @map("admin_role_id")
  adminRole    AdminRole @relation(fields: [adminRoleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("admin")
}

model AdminSetting {
  id String @id @default(uuid())

  // web settings
  webTitle       String?  @map("web_title")
  webFavicon     String?  @map("web_favicon")
  webDescription String?  @map("web_description")
  webKeywords    String[] @map("web_keywords")
  webAuthor      String?  @map("web_author")
  webCopyright   String?  @map("web_copyright")

  // spr settings
  learningSteps                Float[] @map("learning_steps") // Các bước học: 1 phút, 10 phút, 1 ngày (tính theo đơn vị phút)
  lastStepFromLearningToReview Int     @default(5) @map("last_step_from_learning_to_review") // Bước cuối cùng đểtừ leanring sang reviewing.
  iniInterval                  Int     @default(2) @map("ini_interval") // interval đầu tiên từ learning sang reviewing.
  iniEasyInterval              Int     @default(4) @map("ini_easy_interval") // interval đầu tiên từ learning sang reviewing khi nút easy.
  leechThreshold               Int     @default(8) @map("leech_threshold") // Tạm ngưng thẻ nếu quên n lần

  // system fee
  feeUploadPer100Mb Float @default(0.1) @map("fee_upload_per_100_mb")
  percentCommission Float @default(10) @map("percent_commission")
  

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("admin_setting")
}

model AdminRole {
  id          String                @id @default(uuid())
  title       String?
  description String?
  admins      Admin[]
  permissions AdminRolePermission[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("admin_role")
}

model AdminRolePermission {
  adminRoleId       String          @map("id_admin_role")
  adminPermissionId String          @map("id_admin_permission")
  adminRole         AdminRole       @relation(fields: [adminRoleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  adminPermission   AdminPermission @relation(fields: [adminPermissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([adminRoleId, adminPermissionId])
  @@map("admin_role_permission")
}

model AdminPermission {
  id     String                @id @default(uuid())
  object AdminObject
  action AdminAction
  roles  AdminRolePermission[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("admin_permission")
}

model User {
  id            String   @id @default(uuid())
  facebookId    String?  @unique @map("facebook_id")
  googleId      String?  @unique @map("google_id")
  fullName      String   @map("full_name") @db.VarChar(100)
  email         String   @unique @db.VarChar(100)
  passwordHash  String?  @map("password_hash")
  role          UserRole @default(student)
  emailVerified Boolean? @default(false) @map("email_verified")
  avatarUrl     String?  @map("avatar_url")
  status        Status   @default(active)
  country       String   @db.VarChar(50)
  timezone      String?  @db.VarChar(100)

  lastLoginAt DateTime? @map("last_login_at")

  teacherSetting          TeacherSetting?
  courses                 Course[]                 @relation("TeacherCourses")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  lessonProgress          UserLessonProgress[]
  vouchersCreated         Voucher[]                @relation("VoucherCreator")
  reviews                 Review[]                 @relation("UserReviews")
  reviewReplies           ReviewReply[]            @relation("UserReviewReplies")
  questions               Question[]               @relation("UserQuestions")
  platformTransactions    PlatformTransaction[]    @relation("UserPlatformTransactions")
  lessonReviewSettings    LessonReviewSetting[]
  studentSetting          StudentSetting?
  diskSpaceTeacher        DiskSpaceTeacher?

  wallet              Wallet?
  orders              Order[]              @relation("StudentOrders")
  notes               Note[]               @relation("UserNotes")
  wishLists           WishList[]           @relation("UserWishList")
  messages            Message[]            @relation("UserMessages")
  conversationMembers ConversationMember[] @relation("ConversationMembers")
  friendsAsUser       Friend[]             @relation("UserFriends")
  friendsAsFriend     Friend[]             @relation("FriendUsers")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("user")
}

model StudentSetting {
  id         String  @id @default(uuid())
  telegramId String? @unique @map("telegram_id")
  discordId  String? @unique @map("discord_id")

  enabledSpr  Boolean @default(false) @map("enabled_spr")
  sprBot      SprBot  @default(telegram) @map("spr_bot")
  sprModel    AiModel @default(groq) @map("spr_model")
  sprInterval Int?    @default(600) @map("spr_interval")

  streak         Int       @default(0)
  longestStreak  Int       @default(0) @map("longest_streak")
  lastActiveDate DateTime? @map("last_active_date")

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model TeacherSetting {
  id       String  @id @default(uuid())
  userId   String  @unique @map("user_id")
  bio      String?
  headline String?
  website  String?
  facebook String?
  linkedin String?
  youtube  String?
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("teacher_setting")
}

model DiskSpaceTeacher {
  id String @id @default(uuid())
  userId String @unique @map("user_id")

  value Int @map("value")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  from DateTime  @default(now()) @map("created_at")
  to DateTime @default(dbgenerated("NOW() + INTERVAL '30 days'")) @map("to")

  @@map("disk_space_teacher")
}

model Category {
  id       String     @id @default(uuid())
  title    String?
  slug     String?
  parentId String?    @map("parent_id")
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  children Category[] @relation("CategoryHierarchy")
  courses  Course[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("category")
}

model Course {
  id                  String  @id @default(uuid())
  title               String  @db.VarChar(255)
  courseDescriptionId String  @unique @map("course_description_id")
  thumbnailUrl        String? @map("thumbnail_url") @db.VarChar(255)
  teacherId           String  @map("teacher_id")
  price               Float   @default(0) @map("price")
  countStudent        Int     @default(0) @map("count_student")
  categoryId          String  @map("category_id")
  slug                String  @unique
  isPublished         Boolean @default(false) @map("is_published")
  rating              Float   @default(0) @map("rating")
  conversationId      String? @unique @map("conversation_id")

  teacher           User              @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category          Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courseDescription CourseDescription @relation(fields: [courseDescriptionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  conversation      Conversation?     @relation("CourseConversation", fields: [conversationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  chapters          Chapter[]
  vouchers          Voucher[]
  reviews           Review[]          @relation("CourseReviews")

  orders    Order[]    @relation("CourseOrders")
  wishLists WishList[] @relation("CourseWishLists")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("courses")
}

model CourseDescription {
  id                  String  @id @default(uuid())
  headline            String?
  targetKnowledges    String? @map("target_knowledges")
  requirement         String?
  detail              String?
  suitableParticipant String? @map("suitable_participant")
  course              Course?

  @@map("course_description")
}

model Chapter {
  id          String  @id @default(uuid())
  courseId    String  @map("course_id")
  title       String  @db.VarChar(255)
  description String?
  position    Int     @default(0)
  parentId    String? @map("parent_id")

  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parent   Chapter?  @relation("ChapterHierarchy", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  children Chapter[] @relation("ChapterHierarchy")
  lessons  Lesson[]
  slug     String    @unique

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("chapter")
}

model Lesson {
  id          String  @id @default(uuid())
  chapterId   String  @map("chapter_id")
  title       String  @db.VarChar(255)
  description String?
  position    Int     @default(0)
  isFree      Boolean @default(false) @map("is_free")
  viewCount   Int     @default(0) @map("view_count")

  isGenQues Boolean @default(false) @map("is_gen_ques")
  isGenQuiz Boolean @default(false) @map("is_gen_quiz")

  promptForGenQues String? @map("prompt_for_gen_ques")
  promptForGenQuiz String? @map("prompt_for_gen_quiz")

  chapter       Chapter              @relation(fields: [chapterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  videoLesson   VideoLesson?
  files         File[]
  userProgress  UserLessonProgress[]
  questions     Question[]
  notes         Note[]               @relation("LessonNotes")
  reviewSetting LessonReviewSetting?
  slug          String               @unique
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime?            @updatedAt @map("updated_at")

  @@map("lesson")
}

model LessonReviewSetting {
  id            String  @id @default(uuid())
  reviewEnabled Boolean @default(true) @map("review_enabled")

  easinessFactor Float              @default(2.5) @map("easiness_factor") // Hệ số mô tả mức độ dễ
  interval       Int                @default(0) @map("interval") // Khoảng thời gian cho lần ôn tập tiếp theo
  status         LessonReviewStatus @default(new) @map("status")
  reviewStep     Int                @default(1) @map("review_step") // Bước ôn tập hiện tại
  lapsed         Int                @default(0) // Số lần ther bij trả lời sai khi đang ở reviewing
  lastReviewedAt DateTime?          @map("last_reviewed_at") @db.Timestamptz

  note       String?      @map("note")
  difficulty Difficulty   @default(medium) @map("difficulty")
  typeQues   TypeQuestion @default(short_answer) @map("type_ques")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  lessonId String @unique @map("lesson_id")
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model UserLessonProgress {
  id       String         @id @default(uuid())
  userId   String         @map("user_id")
  lessonId String         @map("lesson_id")
  progress LessonProgress @default(not_started) @map("progress")
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  lesson   Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("user_lesson_progress")
}

model VideoLesson {
  id       String @id @default(uuid())
  lessonId String @unique @map("lesson_id")
  videoId  String @map("video_id")
  embedUrl String @map("embed_url")
  size Int? @default(0) @map("size")
  duration Int?
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("video_lesson")
}

model File {
  id       String @id @default(uuid())
  lessonId String @map("lesson_id")
  fileUrl  String @map("file_url")
  fileName String @map("file_name")
  fileSize Int    @map("file_size")

  isForAiQues Boolean @default(false) @map("is_for_ai_ques")
  isForAiQuiz Boolean @default(false) @map("is_for_ai_quiz")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("file")
}

model Question {
  id          String       @id @default(uuid())
  statement   String
  answer      String?
  score       Int?
  explain     String?
  aiFeedback  String?
  isForReview Boolean      @default(false) @map("is_for_review")
  type        TypeQuestion
  difficulty  Difficulty   @default(medium)

  lessonId String @map("lesson_id")
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  userId String @map("user_id")
  user   User   @relation("UserQuestions", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("questions")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Voucher {
  id            String       @id @default(uuid())
  code          String       @unique @db.VarChar(50)
  courseId      String?      @map("course_id")
  discountType  DiscountType @map("discount_type")
  discountValue Float        @map("discount_value")
  startDate     DateTime     @map("start_date")
  endDate       DateTime     @map("end_date")
  usageLimit    Int?         @map("usage_limit")
  usedCount     Int          @default(0) @map("used_count")
  createdBy     String       @map("created_by")
  status        Status       @default(active)

  course  Course? @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  creator User    @relation("VoucherCreator", fields: [createdBy], references: [id], onDelete: Cascade, onUpdate: Cascade)
  orders  Order[] @relation("VoucherOrders")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("voucher")
}

model Review {
  id       String  @id @default(uuid())
  userId   String  @map("user_id")
  courseId String  @map("course_id")
  rating   Int // Rating from 1 to 5
  comment  String? @db.Text

  user    User          @relation("UserReviews", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  course  Course        @relation("CourseReviews", fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  replies ReviewReply[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  // Constraint: One user can only review a course once
  @@unique([userId, courseId])
  @@map("review")
}

model ReviewReply {
  id       String @id @default(uuid())
  reviewId String @map("review_id")
  userId   String @map("user_id")
  comment  String @db.Text

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user   User   @relation("UserReviewReplies", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("review_reply")
}

// -------------schema for payment system : User-------------
enum TransactionType {
  deposit // Nạp tiền
  withdrawal // Rút tiền 
  order 
  disk
  upload
}

enum TransactionStatus {
  pending
  processing
  completed
  cancelled
}

enum PaymentMethod {
  paypal
}

enum OrderStatus {
  processing
  success
  cancelled
}

model Wallet {
  id             String @id @default(uuid())
  userId         String @unique @map("user_id")
  balance        Float  @default(0) // Số dư hiện tại
  totalDeposited Float  @default(0) @map("total_deposited") // Tổng tiền đã nạp
  totalWithdrawn Float  @default(0) @map("total_withdrawn") // Tổng tiền đã rút
  totalEarned    Float  @default(0) @map("total_earned") // Tổng tiền kiếm được từ khóa học
  totalSpent     Float  @default(0) @map("total_spent") // Tổng tiền đã chi (upload, AI)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  transactions Transaction[]
  withdrawals  Withdrawal[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("wallet")
}

model Transaction {
  id            String            @id @default(uuid())
  walletId      String            @map("wallet_id")
  type          TransactionType
  amount        Float // Số tiền (dương: cộng, âm: trừ)
  balanceBefore Float             @map("balance_before") // Số dư trước giao dịch
  balanceAfter  Float             @map("balance_after") // Số dư sau giao dịch
  status        TransactionStatus @default(pending)
  description   String?           @db.Text
  referenceId   String?           @map("reference_id") // ID tham chiếu (orderId, withdrawalId, etc.)
  metadata      Json? // Thông tin bổ sung

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@index([walletId])
  @@index([type])
  @@index([status])
  @@map("transaction")
}

// Model Yêu cầu rút tiền
model Withdrawal {
  id              String            @id @default(uuid())
  walletId        String            @map("wallet_id")
  amount          Float
  email           String            
  status          TransactionStatus @default(pending)
  note            String?           @db.Text
  rejectionReason String?           @map("rejection_reason") @db.Text
  processedBy     String?           @map("processed_by") // Admin ID xử lý
  processedAt     DateTime?         @map("processed_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@index([walletId])
  @@index([status])
  @@map("withdrawal")
}

// Model Đơn hàng (học sinh mua khóa học)
model Order {
  id             String        @id @default(uuid())
  Order_id       String        @unique @map("order_id")
  userId         String        @map("user_id") // Học sinh mua
  courseId       String        @map("course_id")
  discountAmount Float         @default(0) @map("discount_amount") // Số tiền giảm giá
  finalPrice     Float         @map("final_price") // Giá cuối cùng
  voucherId      String?       @map("voucher_id")
  status         OrderStatus   @default(processing)
  paymentMethod  PaymentMethod @map("payment_method")
  paymentId      String?       @map("payment_id") // ID từ cổng thanh toán

  user    User     @relation("StudentOrders", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  course  Course   @relation("CourseOrders", fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  voucher Voucher? @relation("VoucherOrders", fields: [voucherId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@map("order")
}

// -------------schema for payment system : Platform -------------
enum PlatformTransactionType {
  commission_income // Thu hoa hồng từ khóa học (10%)
  upload_fee_income // Thu phí upload bài học
  ai_fee_income // Thu phí sử dụng AI
  disk_space_income // Thu phí sử dụng disk space
  // còn nhiều loại khác nữa, thêm sau ...
}

// Model Ví tổng của nền tảng
model PlatformWallet {
  id      String @id @default(uuid())
  revenue Float  @default(0)

  transactions PlatformTransaction[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("platform_wallet")
}

model PlatformTransaction {
  id            String                  @id @default(uuid())
  walletId      String                  @map("wallet_id")
  type          PlatformTransactionType
  amount        Float // Dương: thu, Âm: chi
  balanceBefore Float                   @map("balance_before")
  balanceAfter  Float                   @map("balance_after")
  description   String                  @db.Text
  performedBy   String?                 @map("performed_by") // Admin ID thực hiện
  userId        String?                 @map("user_id") // User liên quan đến giao dịch
  metadata      Json?

  user   User?          @relation("UserPlatformTransactions", fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  wallet PlatformWallet @relation(fields: [walletId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([walletId])
  @@index([type])
  @@index([userId])
  @@index([createdAt])
  @@map("platform_transaction")
}

