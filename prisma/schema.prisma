generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  teacher
  student
}

enum AdminObject {
  user_management
  course_management
  category_management
}

enum AdminAction {
  view
  edit
}

enum Status {
  active
  inactive
}

model Admin {
  id           String    @id @default(uuid())
  fullName     String    @map("full_name") @db.VarChar(100)
  email        String    @unique @db.VarChar(100)
  passwordHash String    @map("password_hash")
  adminRoleId  String    @map("admin_role_id")
  adminRole    AdminRole @relation(fields: [adminRoleId], references: [id])

  @@map("admin")
}

model AdminRole {
  id          String                  @id @default(uuid())
  title       String?
  description String?
  admins      Admin[]
  permissions AdminRolePermission[]

  @@map("admin_role")
}

model AdminRolePermission {
  adminRoleId       String          @map("id_admin_role")
  adminPermissionId String          @map("id_admin_permission")
  adminRole         AdminRole       @relation(fields: [adminRoleId], references: [id])
  adminPermission   AdminPermission @relation(fields: [adminPermissionId], references: [id])

  @@id([adminRoleId, adminPermissionId])
  @@map("admin_role_permission")
}

model AdminPermission {
  id      String        @id @default(uuid())
  object  AdminObject
  action  AdminAction
  roles   AdminRolePermission[]

  @@map("admin_permission")
}

model User {
  id            String          @id @default(uuid())
  facebookId    String?         @map("facebook_id")
  fullName      String          @map("full_name") @db.VarChar(100)
  email         String          @unique @db.VarChar(100)
  passwordHash  String          @map("password_hash")
  role          UserRole        @default(student)
  emailVerified Boolean?        @map("email_verified") @default(false)
  avatarUrl     String?         @map("avatar_url")
  status        Status          @default(active)
  country       String          @db.VarChar(50)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  
  // Relations
  teacherSetting           TeacherSetting?
  courses                  Course[]                @relation("TeacherCourses")
  emailVerificationTokens  EmailVerificationToken[]

  @@map("user")
}

model TeacherSetting {
  id       String  @id @default(uuid())
  userId   String  @unique @map("user_id")
  bio      String?
  headline String?
  country  String?
  website  String?
  facebook String?
  linkedin String?
  youtube  String?
  user     User    @relation(fields: [userId], references: [id])

  @@map("teacher_setting")
}

model Category {
  id       String     @id @default(uuid())
  title    String?
  slug     String?
  parentId String?    @map("parent_id")
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  courses  Course[]

  @@map("category")
}

model Course {
  id                  String            @id @default(uuid())
  title               String            @db.VarChar(255)
  courseDescriptionId String?           @map("course_description_id")
  thumbnailUrl        String?           @map("thumbnail_url") @db.VarChar(255)
  teacherId           String            @map("teacher_id")
  price               Decimal           @default(0) @db.Decimal(10, 2)
  countStudent        Int?              @map("count_student")
  categoryId          String?           @map("category_id")
  slug                String?
  isPublished         Boolean           @default(false) @map("is_published")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime?         @updatedAt @map("updated_at")
  
  // Relations
  teacher             User              @relation("TeacherCourses", fields: [teacherId], references: [id])
  category            Category?         @relation(fields: [categoryId], references: [id])
  courseDescription   CourseDescription? @relation(fields: [courseDescriptionId], references: [id])

  @@map("courses")
}

model CourseDescription {
  id                   String   @id @default(uuid())
  headline             String?
  targetKnowledges     String?  @map("target_knowledges") // split by comma,
  requirement          String?
  detail               String?
  suitableParticipant  String?  @map("suitable_participant") // split by comma,
  courses              Course[]

  @@map("course_description")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}
