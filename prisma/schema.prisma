generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  teacher
  student
}

enum AdminObject {
  user_management
  course_management
  category_management
}

enum AdminAction {
  view
  edit
}

enum Status {
  active
  warning
  inactive
}

model Admin {
  id           String    @id @default(uuid())
  fullName     String    @map("full_name") @db.VarChar(100)
  email        String    @unique @db.VarChar(100)
  passwordHash String    @map("password_hash")
  adminRoleId  String    @map("admin_role_id")
  adminRole    AdminRole @relation(fields: [adminRoleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("admin")
}

model AdminRole {
  id          String                  @id @default(uuid())
  title       String?
  description String?
  admins      Admin[]
  permissions AdminRolePermission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("admin_role")
}

model AdminRolePermission {
  adminRoleId       String          @map("id_admin_role")
  adminPermissionId String          @map("id_admin_permission")
  adminRole         AdminRole       @relation(fields: [adminRoleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  adminPermission   AdminPermission @relation(fields: [adminPermissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([adminRoleId, adminPermissionId])
  @@map("admin_role_permission")
}

model AdminPermission {
  id      String        @id @default(uuid())
  object  AdminObject
  action  AdminAction
  roles   AdminRolePermission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("admin_permission")
}

model User {
  id            String          @id @default(uuid())
  facebookId    String?         @map("facebook_id")
  fullName      String          @map("full_name") @db.VarChar(100)
  email         String          @unique @db.VarChar(100)
  passwordHash  String          @map("password_hash")
  role          UserRole        @default(student)
  emailVerified Boolean?        @map("email_verified") @default(false)
  avatarUrl     String?         @map("avatar_url")
  status        Status          @default(active)
  country       String          @db.VarChar(50)
  
  teacherSetting           TeacherSetting?
  courses                  Course[]                @relation("TeacherCourses")
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]

  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime?       @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  @@map("user")
}

model TeacherSetting {
  id       String  @id @default(uuid())
  userId   String  @unique @map("user_id")
  bio      String?
  headline String?
  website  String?
  facebook String?
  linkedin String?
  youtube  String?
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("teacher_setting")
}

model Category {
  id       String     @id @default(uuid())
  title    String?
  slug     String?
  parentId String?    @map("parent_id")
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  children Category[] @relation("CategoryHierarchy")
  courses  Course[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  @@map("category")
}

model Course {
  id                  String            @id @default(uuid())
  title               String            @db.VarChar(255)
  courseDescriptionId String            @unique @map("course_description_id")
  thumbnailUrl        String?           @map("thumbnail_url") @db.VarChar(255)
  teacherId           String            @map("teacher_id")
  price               Float             @default(0) @map("price")
  countStudent        Int               @default(0) @map("count_student")
  categoryId          String            @map("category_id")
  slug                String            @unique
  isPublished         Boolean           @default(false) @map("is_published")
  rating              Float             @default(0) @map("rating")
  
  teacher             User              @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category            Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courseDescription   CourseDescription @relation(fields: [courseDescriptionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  chapters            Chapter[]

  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime?         @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  @@map("courses")
}

model CourseDescription {
  id                   String   @id @default(uuid())
  headline             String?
  targetKnowledges     String?  @map("target_knowledges")
  requirement          String?
  detail               String?
  suitableParticipant  String?  @map("suitable_participant")
  course               Course?

  @@map("course_description")
}

model Chapter {
  id          String    @id @default(uuid())
  courseId    String    @map("course_id")
  title       String    @db.VarChar(255)
  description String?
  position    Int       @default(0)
  parentId    String?   @map("parent_id")
  
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parent      Chapter?  @relation("ChapterHierarchy", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  children    Chapter[] @relation("ChapterHierarchy")
  lessons     Lesson[]
  slug        String    @unique

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")

  @@map("chapter")
}

model Lesson {
  id          String     @id @default(uuid())
  chapterId   String     @map("chapter_id")
  title       String     @db.VarChar(255)
  description String?
  position    Int        @default(0)
  isFree      Boolean    @default(false) @map("is_free")
  viewCount   Int        @default(0) @map("view_count")

  chapter     Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  videoLesson VideoLesson?
  files       File[]
  slug        String    @unique
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime?  @updatedAt @map("updated_at")

  @@map("lesson")
}

model VideoLesson {
  id        String  @id @default(uuid())
  lessonId  String  @unique @map("lesson_id")
  videoId   String  @map("video_id")
  embedUrl  String  @map("embed_url")

  duration  Int?     
  lesson    Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("video_lesson")
}

model File {
  id        String  @id @default(uuid())
  lessonId  String  @map("lesson_id")
  fileUrl   String  @map("file_url")
  fileName  String  @map("file_name")
  fileSize  Int     @map("file_size")
  
  lesson    Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("file")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}
