model Note {
  id        String @id @default(uuid())
  userId    String @map("user_id")
  lessonId  String @map("lesson_id")
  content   String @db.Text
  timestamp Int // Timestamp in seconds on the video

  user   User   @relation("UserNotes", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  lesson Lesson @relation("LessonNotes", fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("note")
}

model WishList {
  id       String @id @default(uuid())
  userId   String @map("user_id")
  courseId String @map("course_id")

  user   User   @relation("UserWishList", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  course Course @relation("CourseWishLists", fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([userId, courseId])
  @@map("wish_list")
}

// -------------Analytics Dashboard Data-------------
model Analytics {
  id       String   @id @default(uuid())
  date     DateTime @db.Date // Ngày lưu trữ snapshot
  timezone String   @db.VarChar(100) // Timezone của snapshot

  // Summary cards data
  totalRevenue   Float @default(0) @map("total_revenue")
  revenueChange  Float @default(0) @map("revenue_change") // % thay đổi so với kỳ trước
  totalFees      Float @default(0) @map("total_fees") // Phí platform thu được
  feesChange     Float @default(0) @map("fees_change") // % thay đổi
  newStudents    Int   @default(0) @map("new_students")
  studentsChange Float @default(0) @map("students_change") // % thay đổi
  activeCourses  Int   @default(0) @map("active_courses")
  coursesChange  Float @default(0) @map("courses_change") // % thay đổi
  avgRating      Float @default(0) @map("avg_rating")
  ratingChange   Float @default(0) @map("rating_change") // % thay đổi

  // Detailed metrics
  totalOrders  Int @default(0) @map("total_orders")
  totalUsers   Int @default(0) @map("total_users")
  totalCourses Int @default(0) @map("total_courses")
  totalLessons Int @default(0) @map("total_lessons")
  totalReviews Int @default(0) @map("total_reviews")

  // Chart data - lưu dưới dạng JSON
  chartData Json? @map("chart_data") // Desktop/Mobile visitors data

  createdAt DateTime @default(now()) @map("created_at")
  userId    String   @map("user_id") // Teacher hoặc null cho admin

  @@unique([date, timezone, userId])
  @@index([date])
  @@index([timezone])
  @@index([userId])
  @@map("analytics")
}

// -------------schema for chat system-------------

enum FriendStatus {
  pending
  accepted
  blocked
}

enum ConversationMemberRole {
  admin
  subadmin
  member
}

model Conversation {
  id      String  @id @default(uuid())
  name    String? @db.VarChar(50)
  isGroup Boolean @default(false) @map("is_group")

  members  ConversationMember[]
  messages Message[]
  course   Course?              @relation("CourseConversation")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@index([isGroup])
  @@map("conversation")
}

model ConversationMember {
  conversationId    String                  @map("conversation_id")
  userId            String                  @map("user_id")
  role              ConversationMemberRole?
  lastSeenMessageId String?                 @map("last_seen_message_id")
  lastSeenAt        DateTime?               @map("last_seen_at")

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user            User         @relation("ConversationMembers", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  lastSeenMessage Message?     @relation("LastSeenMessage", fields: [lastSeenMessageId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  joinedAt DateTime @default(now()) @map("joined_at")

  @@id([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@map("conversation_member")
}

model Message {
  id             String  @id @default(uuid())
  conversationId String  @map("conversation_id")
  senderId       String  @map("sender_id")
  message        String? @db.Text
  fileUrl        String? @map("file_url")
  fileName       String? @map("file_name")
  fileSize       Int?    @map("file_size")

  conversation Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sender       User                 @relation("UserMessages", fields: [senderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  seenBy       ConversationMember[] @relation("LastSeenMessage")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("message")
}

model Friend {
  userId     String       @map("user_id")
  friendId   String       @map("friend_id")
  status     FriendStatus @default(pending)
  acceptedAt DateTime?    @map("accepted_at")

  user   User @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  friend User @relation("FriendUsers", fields: [friendId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, friendId])
  @@index([userId])
  @@index([friendId])
  @@index([status])
  @@map("friend")
}
